# =========================================================
# FinanPy AI — Configuração de Variáveis de Ambiente (.env)
# =========================================================
# A aplicação funciona 100% localmente sem nenhuma chave configurada
# utilizando o Motor Determinístico em Python (src/ai_assistant.py).
#
# Para ativar a redação opcional via LLM externo, copie este arquivo
# para ".env" e preencha APENAS UMA das chaves abaixo:

GEMINI_API_KEY=
OPENAI_API_KEY=

# Opcional: chaves de sandbox da Pluggy (para o módulo legado open_finance.py)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
